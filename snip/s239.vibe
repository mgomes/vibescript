[1, 2, 3, 4].each_cons(3) do |window|
  window.sum
end                                 # yields [1, 2, 3] then [2, 3, 4]
[1, 2, 3].reverse_each do |value|
  value * 10
end                                 # yields 3, 2, 1
[1, 2].cycle(2) do |value|
  value + 1
end                                 # yields 1, 2, 1, 2
["a", "b"].each_with_index do |value, index|
  [value, index]
end                                 # yields ("a", 0) then ("b", 1)
