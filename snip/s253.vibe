def strftime_flags
  t = Time.utc(2024, 1, 2, 3, 4, 5)
  {
    day_no_pad:   t.strftime("%-d"),  # "2"
    day_padded:   t.strftime("%03d"), # "002"
    year_wide:    t.strftime("%6Y"),  # "002024"
    month_upper:  t.strftime("%^B"),  # "JANUARY"
    meridian_low: t.strftime("%#p")   # "am"
  }
end
