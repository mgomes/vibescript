"Ada".respond_to?(:length)   # true
"Ada".respond_to?(:nope)     # false
{ name: "x" }.respond_to?(:name) # false  (a data key, not a method)
{ name: "x" }.respond_to?(:keys) # true

class User
end

user = User.new
user.is_a?(User)        # true
user.kind_of?(User)     # true
user.instance_of?(User) # true
42.is_a?(User)          # false
