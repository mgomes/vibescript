[10, 20, 30][-1]            # 30
[1][5]                      # nil
[10, 20, 30, 40][1, 2]      # [20, 30]
[10, 20, 30][3, 1]          # [] (start at the length)
[10, 20, 30][4, 1]          # nil (start past the length)
[1, 2, 3, 4][1..2]          # [2, 3]
[1, 2, 3, 4][-3..-1]        # [2, 3, 4]
[10, 20, 30].at(-1)         # 30
[10, 20, 30, 40].slice(1, 2) # [20, 30]
